{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "strict": true,
    "strictPropertyInitialization": false
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "App.tsx",
    "__tests__/**/*.ts",
    "__tests__/**/*.tsx"
  ],
  "exclude": ["**/node_modules", "**/Pods", "backend-proxy"]
}
